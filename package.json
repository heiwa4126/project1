{
	"name": "project1",
	"version": "0.0.0-alpha1",
	"description": "tsup test template",
	"keywords": [
		"cli",
		"commonjs",
		"demo",
		"esm",
		"example",
		"github-actions",
		"hello-world",
		"learning",
		"sigstore",
		"trusted-publishing",
		"tsup",
		"typescript"
	],
	"license": "MIT",
	"author": "heiwa4126 <heiwa4126@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/heiwa4126/project1.git"
	},
	"bin": {
		"project1": "dist/main.js"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"preinstall": "npm audit",
		"init": "npm ci && npm run build && npm run link",
		"prepublishOnly": "npm run clean && npm run build && npm run test:run && npm run smoketest",
		"clean": "rm -rf dist",
		"build": "tsup",
		"link": "mkdir -p node_modules && ln -sfn ../ node_modules/project1",
		"test": "vitest run",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
		"lint-tsc": "tsc --noEmit",
		"main": "npx project1",
		"ex1": "node ./example/ex1.mjs && node ./example/ex1.cjs && tsx ./example/ex1.ts",
		"smoketest": "npm run ex1 && node dist/main.js",
		"security": "trivy fs --skip-dirs node_modules,cdk.out . && trivy config --skip-dirs node_modules,cdk.out ."
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=18"
	}
}
